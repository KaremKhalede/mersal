# Copy to .env and fill in real values. Never commit .env (already gitignored).

# ---------- Required in every environment ----------

# PostgreSQL connection used for the app's own runtime queries. Local: a plain connection string
# to your local instance. Staging/production behind a pooler (Supabase, Neon, ...): the POOLER
# connection string (Supabase: port 6543, "Transaction" mode). Supabase's dashboard does NOT
# include the `?pgbouncer=true` flag Prisma needs in that string by default — src/lib/db-url.ts
# adds it automatically for any port-6543 URL, so pasting the dashboard value as-is is fine.
DATABASE_URL=

# Unpooled/direct PostgreSQL connection, used only by `prisma migrate`. Locally this is identical
# to DATABASE_URL. Behind a pooler: the DIRECT connection string (Supabase: port 5432), since
# PgBouncer's transaction mode doesn't support the session-level features migrations need.
DIRECT_URL=

# HS256 signing key for session JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# In development, if unset, a fixed dev-only fallback is used (see src/lib/secret.ts).
# In production/staging, the app refuses to start without this set — there is no fallback.
# Use a DIFFERENT value per environment — a staging secret must never equal the production one.
SESSION_SECRET=

# Public base URL of this deployment (e.g. https://chargee-staging.vercel.app).
# REQUIRED in any environment where links are handed to a human:
#   - src/lib/tracking.ts builds the customer's tracking link as ${APP_URL}/track/<trackingToken>
#   - src/modules/users/password-reset.ts builds admin-issued reset links as ${APP_URL}/reset/<token>
# Unset, both go out as relative paths and neither the customer nor a locked-out employee can open
# them.
APP_URL=

# Upstash Redis (REST API — required so the rate limiter in src/lib/rate-limit.ts works from
# Vercel Edge Middleware, which has no raw TCP socket access). Create a free database at
# vercel.com/dashboard → Storage → Upstash → Redis; copy the two REST values from its console.
# If unset or unreachable, the limiter fails open (logs an error, allows the request) rather than
# blocking login/tracking for everyone over a Redis blip — see the try/catch in src/proxy.ts.
#
# SET THESE IN PRODUCTION. Failing open is an acceptable trade for a Redis outage, but running
# permanently without Redis means the brute-force guard on the public tracking page's last-4-digit
# check (src/app/track/[token]/actions.ts) never engages. The tracking token is still 128 bits and
# a customer-submitted delivery request still cannot dispatch anything without an employee
# confirming it, so this is defence-in-depth rather than the only lock — but it is a real layer.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Production-only: first Platform Admin bootstrap ----------
# Used once by `npm run db:bootstrap` (prisma/bootstrap.ts) — never by the running app itself.
# Do NOT reuse prisma/seed.ts (demo data + a shared password) against production.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ---------- Object storage (documents) ----------
# STORAGE_DRIVER unset or "local": documents are written to storage/uploads/ on this instance's
# own disk. Fine for local development. NOT valid on Vercel (or any serverless/ephemeral-filesystem
# host) — the filesystem there is read-only outside /tmp and doesn't persist between invocations,
# so uploads would silently fail or vanish. Staging and production MUST set STORAGE_DRIVER=s3.
# STORAGE_DRIVER=s3: documents go to a private S3-compatible bucket instead (AWS S3, MinIO,
# DigitalOcean Spaces, Cloudflare R2, ...). See src/modules/documents/storage.ts.
# NOTE: the app now REFUSES TO START with STORAGE_DRIVER=local when NODE_ENV=production (see
# buildStorage() in src/modules/documents/storage.ts) — silently losing every upload was worse than
# a loud boot failure. `next build` is exempt; `next start` and serverless invocations are not.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- WhatsApp Business (Meta Cloud API) ----------
# See src/modules/notifications/provider.ts. WHATSAPP_PROVIDER unset or "mock": LogOnlyProvider
# just logs — this is what every automated test and local dev must use (never spend real WhatsApp
# sends on test traffic). WHATSAPP_PROVIDER=meta: PlatformWhatsAppProvider calls the real Cloud API
# using the platform's single central WhatsApp Business number (see templates.ts — every company's
# messages go out through this one sender, branded per-message via {{companyName}}).
WHATSAPP_PROVIDER=mock

# From Meta for Developers → your App → WhatsApp → API Setup.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Only needed if webhook delivery-status callbacks are enabled (src/app/api/webhooks/whatsapp).
# WHATSAPP_APP_SECRET: the Meta App's own secret (App Dashboard → Settings → Basic) — used to verify
# the X-Hub-Signature-256 header Meta signs every webhook POST with. Never the same as the access
# token above. WHATSAPP_WEBHOOK_VERIFY_TOKEN: a value YOU invent and enter in both places — Meta's
# webhook subscription setup, and here — used only for the one-time GET subscription handshake.
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Arshi delivery — see src/modules/delivery/provider.ts. Currently an ArshiMockProvider mock;
# these are unread until a real provider implementation is wired in.
ARSHI_API_BASE_URL=
ARSHI_API_KEY=
ARSHI_WEBHOOK_SECRET=

# ---------- Test/CI only ----------
# Playwright drives every test through the same IP, which would otherwise exhaust the /login and
# /track rate limits within the first few tests. Unlike a blanket "disable rate limiting" flag,
# this is safe to leave set even in a real production project's env vars by accident: only requests
# that send the matching `x-rate-limit-bypass` header (playwright.config.ts / playwright.staging.config.ts
# set it automatically) skip the check — a leaked/misconfigured env var alone never weakens
# protection for real traffic, since real users never send that header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_BYPASS_TOKEN=
